# =============================================================================
# InsightIQ – Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# -- General ------------------------------------------------------------------
APP_NAME=InsightIQ
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # Enable/disable debug mode
APP_SECRET_KEY=changeme      # Generate with: openssl rand -hex 32
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -- Backend (FastAPI / Uvicorn) ----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4                # Number of Uvicorn worker processes
API_RELOAD=true              # Auto-reload on code changes (dev only)

# -- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/insightiq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false          # Log all SQL queries (dev only)

# -- Frontend (Vite / React) --------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# -- Redis (optional – caching / task queues) ---------------------------------
# REDIS_URL=redis://localhost:6379/0

# -- Celery (optional – background task processing) ---------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -- Docker Compose shortcuts -------------------------------------------------
# COMPOSE_PROJECT_NAME=insightiq